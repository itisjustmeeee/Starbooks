generator client {
  provider = "prisma-client-py"
  output   = "../app/db/generated"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RoleEnum {
  Guest
  User
  Admin
  @@map("role_enum")
}

enum StatusEnum {
  Wanted
  Reading
  Done
  Ditched
  @@map("status_enum")
}

model User {
  user_id       BigInt   @id @default(autoincrement())
  username      String   @unique @db.VarChar(100)
  password_hash String
  email         String   @unique @db.VarChar(255)
  role          RoleEnum @default(User)
  created_at    DateTime @default(now()) @db.Timestamp

  books_statuses UsersBooksStatus[]

  @@map("users")
}

model Author {
  author_id BigInt  @id @default(autoincrement())
  name      String  @db.VarChar(100)
  surname   String  @db.VarChar(100)
  image_url String?

  books Book[]

  @@unique([name, surname], name: "uq_authors_name_surname")
  @@map("authors")
}

model Genre {
  genre_id BigInt @id @default(autoincrement())
  name     String @unique @db.VarChar(100)

  books_genres BooksGenres[]

  @@map("genres")
}

model Book {
  book_id         BigInt   @id @default(autoincrement())
  name            String   @db.VarChar(255)
  author_id       BigInt
  description     String
  publishing_date DateTime @db.Date
  image_url       String?
  read_url        String?  // TODO: подтвердить nullable

  author        Author             @relation(fields: [author_id], references: [author_id], onDelete: Restrict)
  books_genres  BooksGenres[]
  users_statuses UsersBooksStatus[]

  @@index([name], name: "idx_books_name")
  @@index([author_id], name: "idx_books_author_id")
  @@index([publishing_date], name: "idx_books_publishing_date")
  @@map("books")
}

model BooksGenres {
  books_genre_id BigInt @id @default(autoincrement())
  book_id        BigInt
  genre_id       BigInt

  book  Book  @relation(fields: [book_id], references: [book_id], onDelete: Cascade)
  genre Genre @relation(fields: [genre_id], references: [genre_id], onDelete: Cascade)

  @@unique([book_id, genre_id], name: "uq_books_genres")
  @@index([genre_id], name: "idx_books_genres_genre_id")
  @@map("books_genres")
}

model UsersBooksStatus {
  books_status_id BigInt     @id @default(autoincrement())
  user_id         BigInt
  book_id         BigInt
  status          StatusEnum

  user User @relation(fields: [user_id], references: [user_id], onDelete: Cascade)
  book Book @relation(fields: [book_id], references: [book_id], onDelete: Cascade)

  @@unique([user_id, book_id], name: "uq_users_books")
  @@index([user_id, status], name: "idx_user_books_status")
  @@index([book_id], name: "idx_user_books_book_id")
  @@map("users_books_statuses")
}